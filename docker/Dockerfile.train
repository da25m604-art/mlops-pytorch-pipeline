# stage 1: build deps into a venv so pip caches stay out of the final image
FROM python:3.11-slim AS deps
WORKDIR /app

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements/train.txt .
# cpu wheels keep the image small, drop the index-url for cuda builds
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        torch==2.8.0 torchvision==0.23.0 && \
    pip install --no-cache-dir PyYAML==6.0.2 numpy==2.1.3

# stage 2: training runtime
FROM python:3.11-slim AS training
WORKDIR /app

COPY --from=deps /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY src/ ./src/
COPY configs/ ./configs/

# config resolution: TRAINING_CONFIG env var, then /app/configs mount, then baked-in default
VOLUME ["/app/data", "/app/checkpoints"]

ENTRYPOINT ["python", "src/train.py"]
